{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PETC Photo Presign Request",
  "description": "Body sent by the desktop sidecar to POST /api/photos/presign to obtain a presigned S3 PUT URL.",
  "type": "object",
  "required": ["testId", "photoId"],
  "additionalProperties": false,
  "properties": {
    "testId":      { "type": "string", "minLength": 1, "description": "Local emission test UUID" },
    "photoId":     { "type": "string", "minLength": 1, "description": "Local test_photos row UUID" },
    "photoType":   { "type": "string", "description": "FRONT | REAR | RESULT | OTHER" },
    "contentType": { "type": "string", "default": "image/jpeg", "description": "MIME type of the photo" },
    "sha256":      { "type": ["string", "null"], "description": "Optional hex-encoded SHA-256 of the photo bytes" }
  }
}
